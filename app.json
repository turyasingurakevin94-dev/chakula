{
  "expo": {
    "name": "Chakula",
    "slug": "chakula",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chakula.student"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chakula.student"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "chakula",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "kevinm123s-team",
    "updates": {
      "url": "https://u.expo.dev/e5eb0b89-d28b-41dc-b2d1-77029b98145a"
    },
    "extra": {
      "eas": {
        "projectId": "e5eb0b89-d28b-41dc-b2d1-77029b98145a"
      }
    }
  }
