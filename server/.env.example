# Copy to .env.local (never commit real keys). Every setting is optional: with none set, the
# server runs in dev mode with an embedded database and pretend SMS, payments and pushes.

PORT=4000

# Postgres connection string. Unset = embedded Postgres (PGlite) stored in server/.data.
# DATABASE_URL=postgres://user:pass@host:5432/chakula

# log (print to the console) or africastalking
SMS_PROVIDER=log
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=

# dev (pretend MoMo that pays itself after a few seconds) or flutterwave (MTN and Airtel).
PAYMENT_PROVIDER=dev
# From the Flutterwave dashboard, Settings > API keys. Test keys (FLWSECK_TEST-…) charge nobody.
# FLW_SECRET_KEY=
# Any long random text; type the same into Settings > Webhooks > Secret hash, with the webhook
# URL https://<your server>/payments/flutterwave/webhook
# FLW_WEBHOOK_HASH=
# The email Flutterwave puts on receipts (students sign in by phone, so they have none).
# FLW_EMAIL=

# log or expo (Expo's free push service)
PUSH_PROVIDER=log

# Create the sample kitchens, menus, a kitchen login and a rider login on an empty database.
SEED=1
