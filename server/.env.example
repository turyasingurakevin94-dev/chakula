# Copy to .env.local (never commit real keys). Every setting is optional: with none set, the
# server runs in dev mode with an embedded database and pretend SMS, payments and pushes.

PORT=4000

# Postgres connection string. Unset = embedded Postgres (PGlite) stored in server/.data.
# DATABASE_URL=postgres://user:pass@host:5432/chakula

# log (print to the console) or africastalking
SMS_PROVIDER=log
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=

# dev (pretend MoMo that pays itself after a few seconds). Real providers are added once chosen.
PAYMENT_PROVIDER=dev

# log or expo (Expo's free push service)
PUSH_PROVIDER=log

# Create the sample kitchens, menus, a kitchen login and a rider login on an empty database.
SEED=1
